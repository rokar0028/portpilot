{
  "name": "portpilot-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "npm run build && node scripts/prepare-standalone.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "start": "next start",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "verify:preview": "python ../api/scripts/verify_preview_deployment.py --api-url http://127.0.0.1:18000 --web-url http://127.0.0.1:13000 --verbose",
    "lint": "eslint src e2e playwright.config.ts \"scripts/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" playwright.config.ts \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" playwright.config.ts \"scripts/*.mjs\""
  },
  "dependencies": {
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
