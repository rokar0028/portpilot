FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./portpilot.db
ADMIN_API_TOKEN=
# Optional natural-language setup parser.
# Option A: Google Gemini API (structured output)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Option B: OpenAI-compatible chat completions.
# Leave keys unset to disable parsing; manual setup selection always works.
SETUP_PARSER_BASE_URL=
SETUP_PARSER_MODEL=
SETUP_PARSER_API_KEY=
SETUP_PARSER_TIMEOUT_SECONDS=15
REPORT_RATE_LIMIT_MAX=10
REPORT_RATE_LIMIT_WINDOW_SECONDS=60
# For a local PostgreSQL server, use:
# DATABASE_URL=postgresql+psycopg://portpilot:portpilot@localhost:5432/portpilot
